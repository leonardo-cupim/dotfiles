font_family	GoogleSansCodeNerdFontMono Nerd Font Mono
# bold_font        auto
# italic_font      auto
# bold_italic_font auto

font_size 13.5
disable_ligatures never

# cursor #cccccc

cursor_shape beam 

copy_on_select yes
clear_selection_on_clipboard_loss yes
remember_window_size  yes

background_opacity 0.95

# BEGIN_KITTY_THEME
# 3024 Night
include current-theme.conf
# END_KITTY_THEME
